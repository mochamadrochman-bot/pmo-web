# Salin menjadi .env lalu isi. Jangan pernah commit berkas .env.

# Koneksi database (docker-compose mengisi otomatis; untuk jalan lokal tanpa Docker, isi manual)
DATABASE_URL=postgres://pmo:dev@localhost:5432/pmo

# Kata sandi Postgres untuk docker-compose. Ganti sebelum dipakai di server.
POSTGRES_PASSWORD=dev

NODE_ENV=development
PORT=3000

# Lama sesi dan parameter verifikasi password lama (samakan dengan Auth.js)
SESSION_TTL_HOURS=6
LEGACY_PBKDF2_ITERATIONS=120000
LEGACY_PBKDF2_KEYLEN=32
