<style>
  .u-cell { display: flex; align-items: center; gap: 10px; }
  .u-av {
    width: 30px; height: 30px; border-radius: 8px; background: var(--soft); color: var(--pri-ink);
    display: grid; place-items: center; font-size: 11px; font-weight: 700; flex: none;
  }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 4px; max-width: 320px; }
  .proj-tag {
    font-size: 11px; padding: 2px 7px; border-radius: 5px;
    background: var(--tint); border: 1px solid var(--line); color: var(--ink);
  }
  .toolbar select { flex: 0 1 175px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 16px; }
  .proyek-list {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 6px 12px;
    margin-top: 8px; font-size: 13px; padding: 12px; border: 1px solid var(--line);
    border-radius: 10px; background: var(--tint); max-height: 220px; overflow-y: auto;
  }
  .proyek-list label { display: flex; gap: 8px; align-items: flex-start; margin: 0; color: var(--ink); font-size: 13px; font-weight: 500; cursor: pointer; }
  .proyek-list input { width: auto; margin-top: 3px; accent-color: var(--pri); }
  .aksi { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  .temp {
    margin-top: 12px; padding: 12px 14px; background: var(--ok-bg); color: var(--ok);
    border: 1px solid rgba(20, 122, 82, .28); border-radius: 9px; font-size: 13.5px;
  }
  .temp code { font-size: 17px; letter-spacing: 1px; background: var(--card); padding: 2px 8px; }
  .hint { font-size: 12px; color: var(--muted); margin-top: 4px; font-weight: 400; }
  @media (max-width: 640px) {
    .tbl-wrap { border: 0; background: transparent; box-shadow: none; overflow: visible; }
    table.akun { background: transparent; }
    table.akun thead { display: none; }
    table.akun, table.akun tbody, table.akun tr, table.akun td { display: block; width: 100%; }
    table.akun tr {
      background: var(--card); border: 1px solid var(--line); border-radius: 11px;
      margin-bottom: 10px; padding: 8px 6px; box-shadow: var(--shadow);
    }
    table.akun td { border: 0; padding: 5px 10px; display: flex; gap: 10px; align-items: center; }
    table.akun td::before { content: attr(data-label); flex: 0 0 100px; color: var(--muted); font-size: 11.5px; font-weight: 600; }
    table.akun td:last-child::before { content: none; }
    table.akun td:last-child { justify-content: flex-end; padding-top: 8px; border-top: 1px dashed var(--line); margin-top: 4px; }
  }
</style>

<div class="pg-head">
  <div>
    <div class="pg-kicker">Administrasi Pengguna</div>
    <h1>Kelola Akun</h1>
    <p class="sub" style="margin:0">Cari akun, atur peran &amp; proyek, buka kunci login, atau reset password sementara.</p>
  </div>
  <button class="btn pri" id="btnTambah" type="button">+ Tambah akun</button>
</div>

<div class="kpis">
  <div class="kpi"><small>Total akun</small><b id="kpiTotal">–</b></div>
  <div class="kpi"><small>Akun aktif</small><b id="kpiAktif">–</b></div>
  <div class="kpi"><small>Password sementara / terkunci</small><b id="kpiWarn">–</b></div>
  <div class="kpi"><small>Akses Asisten AI (Sena)</small><b id="kpiSena">–</b></div>
</div>

<div class="panel" id="panel" hidden>
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap">
    <div>
      <h2 id="panelJudul">Tambah akun</h2>
      <p class="sub" id="panelSub" style="margin:0 0 8px">Akun baru wajib mengganti password saat login pertama.</p>
    </div>
  </div>
  <form id="formAkun">
    <div class="grid2">
      <div>
        <label for="fUsername">Username</label>
        <input id="fUsername" autocomplete="off" />
      </div>
      <div>
        <label for="fNama">Nama lengkap</label>
        <input id="fNama" autocomplete="off" />
      </div>
      <div>
        <label for="fPeran">Peran</label>
        <select id="fPeran">
          <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.label %></option><% }); %>
        </select>
        <div class="hint" id="peranHint"></div>
      </div>
      <div id="statusWrap" hidden>
        <label for="fStatus">Status</label>
        <select id="fStatus">
          <option value="aktif">Aktif</option>
          <option value="nonaktif">Nonaktif (tidak bisa login)</option>
        </select>
      </div>
    </div>

    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:6px">
      <div>
        <label id="proyekLabel" style="margin-bottom:2px">Proyek</label>
        <div class="hint" id="proyekHint" style="margin-top:0"></div>
      </div>
      <input id="projFilterInp" type="search" placeholder="Saring daftar proyek…" aria-label="Saring daftar proyek" style="max-width:220px;height:32px;font-size:12.5px">
    </div>
    <div class="proyek-list" id="proyekList">
      <label><input type="checkbox" value="*" id="cbAll" /> <b>Semua proyek</b></label>
      <% projects.forEach(function (p) { %>
        <label data-proj-opt="<%= (p.name + ' ' + p.id).toLowerCase() %>"><input type="checkbox" class="cbProyek" value="<%= p.id %>" /> <span><%= p.name %> <span class="muted">(<%= p.id %>)</span></span></label>
      <% }); %>
    </div>

    <label class="sena-cb" style="display:flex;align-items:flex-start;gap:8px;margin-top:14px;font-weight:500;color:var(--ink);cursor:pointer">
      <input type="checkbox" id="fSena" style="width:auto;margin:3px 0 0;accent-color:var(--pri)" />
      <span>Akses Sena (asisten AI)<span class="hint" style="display:block;font-weight:400" id="senaHint">Untuk pimpinan yang perlu bertanya ke Sena, misalnya direktur. Sena hanya membaca proyek yang boleh dibuka akun ini. Admin selalu punya akses.</span></span>
    </label>

    <div class="aksi">
      <button class="btn pri" type="submit" id="btnSimpan">Simpan</button>
      <button class="btn" type="button" id="btnReset" hidden>Reset password</button>
      <button class="btn" type="button" id="btnUnlock" hidden>Buka kunci</button>
      <button class="btn" type="button" id="btnBatal">Batal</button>
    </div>
    <div class="err" id="formErr" role="alert"></div>
    <div class="temp" id="tempBox" hidden></div>
  </form>
</div>

<div class="toolbar">
  <div class="search-box">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input id="akunSearch" type="search" placeholder="Cari username, nama, atau proyek…" aria-label="Cari akun">
  </div>
  <select id="akunRoleFilter" aria-label="Filter peran">
    <option value="">Semua peran</option>
    <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.label %></option><% }); %>
  </select>
  <select id="akunStatusFilter" aria-label="Filter status">
    <option value="">Semua status</option>
    <option value="aktif">Aktif</option>
    <option value="temp">Password sementara</option>
    <option value="locked">Terkunci</option>
    <option value="nonaktif">Nonaktif</option>
  </select>
  <span class="tb-count" id="akunCount">Memuat…</span>
</div>

<div class="tbl-wrap">
  <div class="tbl-scroll">
    <table class="tbl akun">
      <thead>
        <tr><th>Akun</th><th>Peran</th><th>Proyek</th><th>Status</th><th>Login terakhir</th><th style="text-align:right">Aksi</th></tr>
      </thead>
      <tbody id="rows"><tr><td colspan="6" class="muted">Memuat…</td></tr></tbody>
    </table>
  </div>
</div>

<script>
(function () {
  var ME = <%- JSON.stringify(user.id).replace(/</g, '\\u003c') %>;
  var PROJECT_NAMES = <%- JSON.stringify(projects.reduce(function (m, p) { m[p.id] = p.name; return m; }, {})).replace(/</g, '\\u003c') %>;
  var ROLE_LABEL = <%- JSON.stringify(roles.reduce(function (m, r) { m[r.id] = r.label; return m; }, { reviewer: 'Reviewer' })).replace(/</g, '\\u003c') %>;
  var HINT = {
    admin: 'Melihat dan mengedit semua proyek, serta mengelola akun.',
    input: 'Melihat semua proyek, mengedit hanya proyek yang dicentang.',
    kontraktor: 'Hanya melihat proyek yang dicentang, hanya modul EPCC Control.',
    viewer: 'Melihat semua proyek, tidak bisa mengedit.'
  };
  var PROYEK_HINT = {
    admin: 'Admin selalu bisa mengakses semua proyek; centang tidak berpengaruh.',
    input: 'Proyek yang boleh diedit.',
    kontraktor: 'Proyek yang boleh dilihat dan diisi EPCC-nya (wajib minimal satu).',
    viewer: 'Viewer melihat semua proyek; centang tidak berpengaruh.'
  };

  var users = [];
  var editing = null;
  var $ = function (id) { return document.getElementById(id); };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmtDate(v) {
    if (!v) return '<span class="muted">belum pernah</span>';
    var d = new Date(v);
    return esc(d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) + ' ' +
      d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }));
  }
  function projNamesOf(ids) {
    if (!ids || !ids.length) return '';
    if (ids.indexOf('*') >= 0) return 'Semua proyek';
    return ids.map(function (id) { return PROJECT_NAMES[id] || id; }).join(' ');
  }
  function projText(ids) {
    if (!ids || !ids.length) return '<span class="muted">—</span>';
    if (ids.indexOf('*') >= 0) return '<span class="proj-tag">Semua proyek</span>';
    return '<div class="proj-tags">' + ids.map(function (id) { return '<span class="proj-tag">' + esc(PROJECT_NAMES[id] || id) + '</span>'; }).join('') + '</div>';
  }

  async function api(method, url, body) {
    var res = await fetch(url, {
      method: method,
      headers: body ? { 'content-type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined
    });
    var json = await res.json().catch(function () { return { ok: false, error: 'Jawaban server tidak terbaca.' }; });
    if (!json.ok) throw new Error(json.error || 'Gagal.');
    return json.data;
  }

  async function load() {
    try {
      users = await api('GET', '/api/admin/users');
      render();
    } catch (e) {
      $('rows').innerHTML = '<tr><td colspan="6" class="err">' + esc(e.message) + '</td></tr>';
    }
  }

  function updateKpis() {
    var aktif = 0, warn = 0, sena = 0;
    users.forEach(function (u) {
      if (u.status === 'aktif') aktif++;
      if (u.must_change_password || u.locked) warn++;
      if (u.sena_access || u.role === 'admin') sena++;
    });
    $('kpiTotal').textContent = users.length;
    $('kpiAktif').textContent = aktif;
    $('kpiWarn').textContent = warn;
    $('kpiSena').textContent = sena;
  }

  function filteredUsers() {
    var q = ($('akunSearch').value || '').trim().toLowerCase();
    var rf = $('akunRoleFilter').value;
    var sf = $('akunStatusFilter').value;
    return users.filter(function (u) {
      if (rf && u.role !== rf) return false;
      if (sf === 'aktif' && (u.status !== 'aktif' || u.locked || u.must_change_password)) return false;
      if (sf === 'temp' && !u.must_change_password) return false;
      if (sf === 'locked' && !u.locked) return false;
      if (sf === 'nonaktif' && u.status !== 'nonaktif') return false;
      if (q) {
        var hay = [u.username, u.full_name, ROLE_LABEL[u.role] || u.role, projNamesOf(u.project_ids)].join(' ').toLowerCase();
        if (hay.indexOf(q) < 0) return false;
      }
      return true;
    });
  }

  function render() {
    updateKpis();
    if (!users.length) {
      $('akunCount').textContent = '0 akun';
      $('rows').innerHTML = '<tr><td colspan="6" class="muted">Belum ada akun.</td></tr>';
      return;
    }
    var list = filteredUsers();
    $('akunCount').textContent = 'Menampilkan ' + list.length + ' dari ' + users.length + ' akun';
    if (!list.length) {
      $('rows').innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:24px">Tidak ada akun yang cocok dengan kata kunci atau filter tersebut.</td></tr>';
      return;
    }
    $('rows').innerHTML = list.map(function (u) {
      var st = u.status === 'aktif' ? '' : '<span class="badge b-off">Nonaktif</span> ';
      if (u.locked) st += '<span class="badge b-lock">Terkunci</span> ';
      if (u.must_change_password) st += '<span class="badge b-temp">Password sementara</span>';
      if (!st) st = '<span class="badge b-ok">Aktif</span>';
      var init = String(u.full_name || u.username || '?').split(/\s+/).map(function (p) { return p[0] || ''; }).join('').slice(0, 2).toUpperCase();
      return '<tr>' +
        '<td data-label="Akun"><div class="u-cell"><span class="u-av">' + esc(init) + '</span><div><b>' + esc(u.username) + '</b>' + (u.id === ME ? ' <span class="badge b-neu">Anda</span>' : '') + '<div class="muted" style="font-size:12px">' + esc(u.full_name) + '</div></div></div></td>' +
        '<td data-label="Peran"><span class="badge b-' + esc(u.role) + '">' + esc(ROLE_LABEL[u.role] || u.role) + '</span>' + (u.sena_access && u.role !== 'admin' ? ' <span class="badge b-sena" title="Boleh memakai Sena">Sena</span>' : '') + '</td>' +
        '<td data-label="Proyek">' + projText(u.project_ids) + '</td>' +
        '<td data-label="Status">' + st + '</td>' +
        '<td data-label="Login terakhir">' + fmtDate(u.last_login_at) + '</td>' +
        '<td style="text-align:right"><button class="btn kecil" type="button" data-edit="' + esc(u.id) + '">Ubah</button></td>' +
        '</tr>';
    }).join('');
  }

  function setChecks(ids) {
    ids = ids || [];
    var all = ids.indexOf('*') >= 0;
    $('cbAll').checked = all;
    document.querySelectorAll('.cbProyek').forEach(function (cb) {
      cb.checked = !all && ids.indexOf(cb.value) >= 0;
      cb.disabled = all;
    });
  }
  function getChecks() {
    if ($('cbAll').checked) return ['*'];
    return Array.prototype.filter.call(document.querySelectorAll('.cbProyek'), function (cb) { return cb.checked; })
      .map(function (cb) { return cb.value; });
  }
  function updateHints() {
    var r = $('fPeran').value;
    $('peranHint').textContent = HINT[r] || '';
    $('proyekHint').textContent = PROYEK_HINT[r] || '';
    $('cbAll').parentElement.hidden = (r === 'kontraktor');
    if (r === 'kontraktor' && $('cbAll').checked) setChecks([]);
    var adm = r === 'admin';
    $('fSena').disabled = adm;
    if (adm) $('fSena').checked = true;
  }

  function openPanel(u) {
    editing = u || null;
    $('formErr').textContent = '';
    $('tempBox').hidden = true;
    $('panel').hidden = false;
    $('projFilterInp').value = '';
    document.querySelectorAll('[data-proj-opt]').forEach(function (el) { el.hidden = false; });
    $('fUsername').value = u ? u.username : '';
    $('fUsername').disabled = !!u;
    $('fNama').value = u ? u.full_name : '';
    $('fPeran').value = u ? u.role : 'viewer';
    $('fStatus').value = u ? u.status : 'aktif';
    $('statusWrap').hidden = !u;
    var self = u && u.id === ME;
    $('fPeran').disabled = !!self;
    $('fStatus').disabled = !!self;
    $('btnReset').hidden = !u;
    $('btnUnlock').hidden = !(u && u.locked);
    $('panelJudul').textContent = u ? 'Ubah akun ' + u.username : 'Tambah akun';
    $('panelSub').textContent = u
      ? (self ? 'Ini akun Anda sendiri: peran dan status tidak bisa diubah dari sini.' : 'Perubahan peran, status, atau proyek langsung mengeluarkan akun ini dari semua perangkat.')
      : 'Password sementara dibuat otomatis. Akun baru wajib menggantinya saat login pertama.';
    setChecks(u ? u.project_ids : []);
    $('fSena').checked = !!(u && (u.sena_access || u.role === 'admin'));
    updateHints();
    $('panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    (u ? $('fNama') : $('fUsername')).focus();
  }

  function showTemp(username, pw) {
    $('tempBox').hidden = false;
    $('tempBox').innerHTML = 'Password sementara untuk <b>' + esc(username) + '</b>: <code>' + esc(pw) + '</code>' +
      '<div class="hint">Salin dan berikan langsung ke pemilik akun. Password ini tidak akan ditampilkan lagi.</div>';
  }

  $('akunSearch').addEventListener('input', render);
  $('akunRoleFilter').addEventListener('change', render);
  $('akunStatusFilter').addEventListener('change', render);
  $('projFilterInp').addEventListener('input', function () {
    var pq = (this.value || '').trim().toLowerCase();
    document.querySelectorAll('[data-proj-opt]').forEach(function (el) {
      el.hidden = !!pq && el.getAttribute('data-proj-opt').indexOf(pq) < 0;
    });
  });

  $('btnTambah').addEventListener('click', function () { openPanel(null); });
  $('btnBatal').addEventListener('click', function () { $('panel').hidden = true; editing = null; });
  $('fPeran').addEventListener('change', updateHints);
  $('cbAll').addEventListener('change', function () { setChecks(this.checked ? ['*'] : []); });
  $('rows').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-edit]');
    if (!btn) return;
    var id = btn.getAttribute('data-edit');
    openPanel(users.find(function (u) { return u.id === id; }));
  });

  $('formAkun').addEventListener('submit', async function (e) {
    e.preventDefault();
    $('formErr').textContent = '';
    var btn = $('btnSimpan');
    btn.disabled = true;
    try {
      if (editing) {
        var body = { full_name: $('fNama').value, project_ids: getChecks(), sena_access: $('fSena').checked };
        if (editing.id !== ME) { body.role = $('fPeran').value; body.status = $('fStatus').value; }
        await api('PATCH', '/api/admin/users/' + encodeURIComponent(editing.id), body);
        $('panel').hidden = true;
        editing = null;
      } else {
        var username = $('fUsername').value.trim().toLowerCase();
        var data = await api('POST', '/api/admin/users', {
          username: username, full_name: $('fNama').value, role: $('fPeran').value, project_ids: getChecks(), sena_access: $('fSena').checked
        });
        if (data.tempPassword) showTemp(username, data.tempPassword);
        $('fUsername').disabled = true;
        editing = { id: data.id, username: username };
      }
      await load();
    } catch (ex) {
      $('formErr').textContent = ex.message;
    } finally {
      btn.disabled = false;
    }
  });

  $('btnReset').addEventListener('click', async function () {
    if (!editing) return;
    if (!confirm('Reset password ' + editing.username + '? Akun ini akan keluar dari semua perangkat dan wajib mengganti password.')) return;
    $('formErr').textContent = '';
    try {
      var data = await api('POST', '/api/admin/users/' + encodeURIComponent(editing.id) + '/reset-password');
      showTemp(editing.username, data.tempPassword);
      await load();
    } catch (ex) {
      $('formErr').textContent = ex.message;
    }
  });

  $('btnUnlock').addEventListener('click', async function () {
    if (!editing) return;
    $('formErr').textContent = '';
    try {
      await api('PATCH', '/api/admin/users/' + encodeURIComponent(editing.id), { unlock: true });
      $('btnUnlock').hidden = true;
      await load();
    } catch (ex) {
      $('formErr').textContent = ex.message;
    }
  });

  load();
})();
</script>
