<style>
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 14px; }
  .note { font-size: 13px; color: var(--muted); margin-top: 8px; line-height: 1.55; }
  .acc-box { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--tint); margin-top: 10px; }
  .code-copy { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 10px 12px; background: var(--tint); border: 1px solid var(--line); border-radius: 9px; margin-top: 10px; }
  .code-copy code { flex: 1; background: transparent; border: 0; padding: 0; font-size: 12.5px; color: var(--navy); }
</style>

<div class="pg-head">
  <div>
    <div class="pg-kicker">Integrasi Drive &amp; Sheets</div>
    <h1>Koneksi Google</h1>
    <p class="sub" style="margin:0">Dipakai untuk foto Portal dan Story Lapangan, galeri, lampiran dokumen, serta sinkron spreadsheet otomatis.</p>
  </div>
</div>

<% if (msg) { %><div class="msg ok"><%= msg %></div><% } %>
<% if (err) { %><div class="msg err"><%= err %></div><% } %>

<div class="cols-2" style="grid-template-columns:1fr 1fr">
  <div class="panel">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px">
      <h2 style="margin:0">Status OAuth Drive</h2>
      <% if (!st.configured) { %>
        <span class="badge wait">Belum disetel</span>
      <% } else if (!st.connected) { %>
        <span class="badge off">Belum terhubung</span>
      <% } else { %>
        <span class="badge on">Terhubung</span>
      <% } %>
    </div>
    <% if (!st.configured) { %>
      <p class="note">Isi <code>GOOGLE_CLIENT_ID</code> dan <code>GOOGLE_CLIENT_SECRET</code> di Coolify (aplikasi pmo-web → Environment Variables), lalu Redeploy.</p>
    <% } else if (!st.connected) { %>
      <p class="note">Klik tombol di bawah dan masuk dengan akun Google <b>pemilik</b> folder Drive dan spreadsheet PMO DASHBOARD. Jika Google menampilkan peringatan "aplikasi belum diverifikasi", pilih <b>Advanced → Go to PMO Dashboard</b>, lalu centang semua izin.</p>
      <div class="row"><a class="btn pri" href="/admin/google/connect">Hubungkan akun Google</a></div>
    <% } else { %>
      <div class="acc-box">
        <div style="font-weight:700;color:var(--navy)"><%= st.email || 'akun Google' %></div>
        <% if (st.connectedAt) { %><div style="font-size:12px;color:var(--muted);margin-top:2px">Sejak <%= new Date(st.connectedAt).toLocaleString('id-ID', { timeZone: 'Asia/Bangkok' }) %></div><% } %>
      </div>
      <% if (st.lastError) { %><p class="note" style="color:var(--err)">Galat terakhir: <%= st.lastError %></p><% } %>
      <div class="row">
        <button class="btn pri" id="test" type="button">Uji koneksi</button>
        <a class="btn" href="/admin/google/connect">Hubungkan ulang</a>
        <button class="btn danger" id="off" type="button">Putuskan</button>
      </div>
      <div class="note" id="out" role="status"></div>
    <% } %>
  </div>

  <div class="panel">
    <h2>Pengaturan Google Cloud</h2>
    <p class="note" style="margin-top:2px">Authorized redirect URI di OAuth client harus persis:</p>
    <div class="code-copy">
      <code id="redirUri"><%= redirectUri %></code>
      <button type="button" class="btn sm" id="copyUri">Salin URI</button>
    </div>
  </div>
</div>

<script>
(function () {
  var out = document.getElementById('out');
  var t = document.getElementById('test'), o = document.getElementById('off'), c = document.getElementById('copyUri');
  if (c) c.addEventListener('click', function () {
    var txt = document.getElementById('redirUri').textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(txt).then(function () { c.textContent = 'Tersalin ✓'; setTimeout(function () { c.textContent = 'Salin URI'; }, 2000); });
    }
  });
  if (t) t.addEventListener('click', async function () {
    out.textContent = 'Menguji…';
    var j = await (await fetch('/api/admin/google/test', { method: 'POST' })).json();
    out.textContent = j.ok ? 'Berhasil. Drive terbaca sebagai ' + (j.data.email || '-') + '.' : 'Gagal: ' + j.error;
  });
  if (o) o.addEventListener('click', async function () {
    if (!confirm('Putuskan koneksi Google? Foto, galeri, dan lampiran tidak akan tampil sampai dihubungkan lagi.')) return;
    await fetch('/api/admin/google/disconnect', { method: 'POST' });
    location.reload();
  });
})();
</script>
