<style>
  .kel tr.sub td:first-child { padding-left: 34px; position: relative; }
  .kel tr.sub td:first-child::before {
    content: "↳"; position: absolute; left: 14px; top: 12px;
    color: var(--muted); font-weight: 700;
  }
  .kel select { max-width: 270px; margin: 0; }
  .kel select:disabled { opacity: .6; cursor: not-allowed; }
  .pid { display: block; font-size: 12px; color: var(--muted); }
  .tag {
    display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 7px;
    border-radius: 6px; background: var(--tint); border: 1px solid var(--line); color: var(--muted); margin-left: 6px;
  }
  .legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 8px; font-size: 13px; }
  .legend div { border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; background: var(--tint); }
  .legend b { display: block; color: var(--navy); margin-bottom: 2px; }
  .savebar { display: flex; align-items: center; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .changed { font-size: 13px; color: var(--warn); font-weight: 600; }
  .toolbar select { flex: 0 1 180px; }
  @media (max-width: 640px) {
    .tbl-card { border: 0; background: transparent; box-shadow: none; }
    .kel thead { display: none; }
    .kel, .kel tbody, .kel tr, .kel td { display: block; width: 100%; }
    .kel tr {
      background: var(--card); border: 1px solid var(--line); border-radius: 11px;
      padding: 8px 10px; margin-bottom: 10px; box-shadow: var(--shadow);
    }
    .kel tr.sub { margin-left: 14px; width: calc(100% - 14px); }
    .kel tr.sub td:first-child::before { content: none; }
    .kel td { border: 0; padding: 4px 0; }
    .kel tr.sub td:first-child { padding-left: 0; }
    .kel td[data-l]::before { content: attr(data-l); display: block; font-size: 11px; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; font-weight: 600; }
    .kel select { max-width: none; }
  }
</style>

<div class="pg-head">
  <div>
    <div class="pg-kicker">Struktur Portofolio</div>
    <h1>Kelompok Proyek</h1>
    <p class="sub" style="margin:0">Menentukan kelompok setiap proyek untuk tampilan Portal dan laporan. Perhitungan progres dan keuangan tetap sendiri-sendiri per proyek.</p>
  </div>
  <% if (!error && projects.length) { %>
    <button class="btn pri" id="saveBtn" type="button" disabled>Simpan perubahan</button>
  <% } %>
</div>

<% if (!error && projects.length) { %>
<div class="kpis" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr))">
  <div class="kpi"><small>Proyek Pengembangan</small><b id="kelKpiDev">–</b></div>
  <div class="kpi"><small>Investasi Rutin</small><b id="kelKpiRutin">–</b></div>
  <div class="kpi"><small>Sub-proyek</small><b id="kelKpiSub">–</b></div>
</div>
<% } %>

<div class="panel">
  <div class="legend">
    <div><b>Pengembangan</b>Proyek investasi pengembangan. Item FS (Plant Cost, IDC, PM Cost) boleh belum lengkap.</div>
    <div><b>Rutin</b>Proyek investasi rutin, cukup dengan nilai kontrak.</div>
    <div><b>Sub-proyek</b>Paket yang laporannya dikelompokkan di bawah proyek Pengembangan induknya.</div>
  </div>
</div>

<% if (error) { %>
  <div class="panel"><p class="err" style="margin:0"><%= error %></p></div>
<% } else if (!projects.length) { %>
  <div class="panel"><p class="muted" style="margin:0">Belum ada proyek di spreadsheet.</p></div>
<% } else { %>
  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="kelSearch" type="search" placeholder="Saring nama, ID proyek, atau tim…" aria-label="Saring proyek">
    </div>
    <select id="kelTypeFilter" aria-label="Filter tipe kelompok">
      <option value="">Semua tipe</option>
      <option value="PENGEMBANGAN">Pengembangan</option>
      <option value="RUTIN">Rutin</option>
      <option value="SUB">Sub-proyek</option>
    </select>
    <span class="tb-count" id="kelCount"><%= projects.length %> proyek</span>
  </div>

  <div class="tbl-card">
    <div class="tbl-scroll">
      <table class="kel" id="kel">
        <thead><tr><th>Proyek</th><th style="width:200px">Tipe</th><th style="width:270px">Proyek induk</th></tr></thead>
        <tbody>
          <% projects.forEach(function (p) { %>
            <tr data-id="<%= p.id %>" data-q="<%= (p.name + ' ' + p.id + ' ' + (p.team || '')).toLowerCase() %>" class="<%= p.type === 'SUB' ? 'sub' : '' %>">
              <td><b><%= p.name %></b><% if (!p.active) { %><span class="tag">belum ada data</span><% } %><span class="pid"><%= p.id %><%= p.team ? ' · ' + p.team : '' %></span></td>
              <td data-l="Tipe">
                <select class="t" aria-label="Tipe <%= p.name %>">
                  <option value="PENGEMBANGAN" <%= p.type === 'PENGEMBANGAN' ? 'selected' : '' %>>Pengembangan</option>
                  <option value="RUTIN" <%= p.type === 'RUTIN' ? 'selected' : '' %>>Rutin</option>
                  <option value="SUB" <%= p.type === 'SUB' ? 'selected' : '' %>>Sub-proyek</option>
                </select>
              </td>
              <td data-l="Proyek induk">
                <select class="p" aria-label="Proyek induk <%= p.name %>" data-cur="<%= p.parent %>"></select>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="savebar">
    <span class="changed" id="changed" hidden>Ada perubahan yang belum disimpan. Klik "Simpan perubahan" di kanan atas.</span>
    <div class="err" id="err" role="alert" style="margin:0"></div>
    <div class="ok" id="ok" role="status" style="margin:0"></div>
  </div>
<% } %>

<script>
(function () {
  var table = document.getElementById('kel');
  if (!table) return;
  var names = {};
  <% projects.forEach(function (p) { %>names[<%- JSON.stringify(p.id) %>] = <%- JSON.stringify(p.name) %>;<% }) %>
  var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
  var btn = document.getElementById('saveBtn'), changed = document.getElementById('changed');
  var err = document.getElementById('err'), ok = document.getElementById('ok');
  var qInp = document.getElementById('kelSearch'), tf = document.getElementById('kelTypeFilter');
  var initial = JSON.stringify(state());

  function state() {
    return rows.map(function (tr) {
      var t = tr.querySelector('.t').value, p = tr.querySelector('.p');
      return { id: tr.getAttribute('data-id'), type: t, parent: t === 'SUB' ? (p.value || p.getAttribute('data-cur') || '') : '' };
    });
  }
  function applyFilter() {
    var q = (qInp && qInp.value || '').trim().toLowerCase();
    var tp = (tf && tf.value) || '';
    var shown = 0;
    rows.forEach(function (tr) {
      var rowType = tr.querySelector('.t').value;
      var hit = (!tp || rowType === tp) && (!q || (tr.getAttribute('data-q') || '').indexOf(q) >= 0);
      tr.hidden = !hit;
      if (hit) shown++;
    });
    if (document.getElementById('kelCount')) {
      document.getElementById('kelCount').textContent = 'Menampilkan ' + shown + ' dari ' + rows.length + ' proyek';
    }
  }
  function refresh() {
    var dev = rows.filter(function (tr) { return tr.querySelector('.t').value === 'PENGEMBANGAN'; }).map(function (tr) { return tr.getAttribute('data-id'); });
    var nDev = 0, nRut = 0, nSub = 0;
    rows.forEach(function (tr) {
      var id = tr.getAttribute('data-id'), t = tr.querySelector('.t').value, sel = tr.querySelector('.p');
      if (t === 'PENGEMBANGAN') nDev++; else if (t === 'RUTIN') nRut++; else nSub++;
      var cur = sel.value || sel.getAttribute('data-cur') || '';
      tr.classList.toggle('sub', t === 'SUB');
      if (t !== 'SUB') { sel.innerHTML = '<option value="">—</option>'; sel.disabled = true; return; }
      sel.disabled = false;
      var opts = '<option value="">Pilih proyek induk…</option>';
      dev.filter(function (d) { return d !== id; }).forEach(function (d) {
        opts += '<option value="' + d + '"' + (d === cur ? ' selected' : '') + '>' + String(names[d] || d).replace(/</g, '&lt;') + '</option>';
      });
      sel.innerHTML = opts;
      sel.setAttribute('data-cur', sel.value);
    });
    if (document.getElementById('kelKpiDev')) document.getElementById('kelKpiDev').textContent = nDev + ' proyek';
    if (document.getElementById('kelKpiRutin')) document.getElementById('kelKpiRutin').textContent = nRut + ' proyek';
    if (document.getElementById('kelKpiSub')) document.getElementById('kelKpiSub').textContent = nSub + ' paket';
    var dirty = JSON.stringify(state()) !== initial;
    btn.disabled = !dirty;
    changed.hidden = !dirty;
    applyFilter();
  }
  if (qInp) qInp.addEventListener('input', applyFilter);
  if (tf) tf.addEventListener('change', applyFilter);
  table.addEventListener('change', function (e) {
    if (e.target.classList.contains('p')) e.target.setAttribute('data-cur', e.target.value);
    ok.textContent = ''; err.textContent = '';
    refresh();
  });
  btn.addEventListener('click', async function () {
    err.textContent = ''; ok.textContent = '';
    var data = state();
    var miss = data.filter(function (x) { return x.type === 'SUB' && !x.parent; });
    if (miss.length) { err.textContent = 'Pilih proyek induk untuk: ' + miss.map(function (x) { return names[x.id] || x.id; }).join(', ') + '.'; return; }
    btn.disabled = true;
    try {
      var res = await fetch('/api/admin/kelompok', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ rows: data }) });
      var json = await res.json();
      if (!json.ok) throw new Error(json.error || 'Gagal menyimpan.');
      initial = JSON.stringify(state());
      refresh();
      ok.textContent = 'Kelompok proyek tersimpan. Portal langsung memakai pengelompokan ini.';
    } catch (ex) {
      err.textContent = ex.message;
      refresh();
    }
  });
  refresh();
})();
</script>
