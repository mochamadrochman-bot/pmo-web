<style>
  .panel { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin: 0 0 18px; }
  .panel h2 { font-size: 16px; margin: 0 0 6px; color: var(--navy); }
  .muted { color: var(--muted); }
  .btn { padding: 9px 16px; border-radius: 8px; border: 0; background: var(--navy); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .btn:disabled { opacity: .5; cursor: default; }
  .ok { color: #166534; font-size: 14px; margin-top: 12px; }
  .kel { width: 100%; border-collapse: collapse; margin-top: 12px; }
  .kel th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .kel td { padding: 10px; border-bottom: 1px solid #eef1f4; vertical-align: middle; font-size: 14px; }
  .kel tr.sub td:first-child { padding-left: 28px; }
  .kel select { width: 100%; max-width: 260px; margin: 0; }
  .kel select:disabled { background: #f3f5f7; color: #9aa5b1; }
  .pid { display: block; font-size: 12px; color: var(--muted); }
  .tag { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 99px; background: #eef2f6; color: #5b6773; margin-left: 6px; }
  .legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 10px; font-size: 13px; }
  .legend div { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .legend b { display: block; color: var(--navy); margin-bottom: 2px; }
  .savebar { display: flex; align-items: center; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .changed { font-size: 13px; color: #92400e; }
  @media (max-width: 640px) {
    .kel thead { display: none; }
    .kel, .kel tbody, .kel tr, .kel td { display: block; width: 100%; }
    .kel tr { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; margin-bottom: 10px; }
    .kel tr.sub { margin-left: 14px; width: calc(100% - 14px); }
    .kel td { border: 0; padding: 4px 0; }
    .kel tr.sub td:first-child { padding-left: 0; }
    .kel td[data-l]::before { content: attr(data-l); display: block; font-size: 11px; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
    .kel select { max-width: none; }
  }
</style>

<h1>Kelompok Proyek</h1>
<p class="sub">Menentukan kelompok setiap proyek untuk tampilan Portal dan laporan. Perhitungan progres dan keuangan tetap sendiri-sendiri per proyek.</p>

<div class="panel">
  <div class="legend">
    <div><b>Pengembangan</b>Proyek investasi pengembangan. Item FS (Plant Cost, IDC, PM Cost) boleh belum lengkap.</div>
    <div><b>Rutin</b>Proyek investasi rutin, cukup dengan nilai kontrak.</div>
    <div><b>Sub-proyek</b>Paket yang laporannya dikelompokkan di bawah proyek Pengembangan induknya.</div>
  </div>
</div>

<div class="panel">
  <h2>Daftar proyek</h2>
  <% if (error) { %>
    <p class="err"><%= error %></p>
  <% } else if (!projects.length) { %>
    <p class="muted">Belum ada proyek di spreadsheet.</p>
  <% } else { %>
    <p class="muted" style="margin:0;font-size:13px">Proyek baru otomatis masuk <b>Pengembangan</b> sampai diubah di sini. Pengaturan ini disimpan di server, jadi tidak hilang saat sinkron atau impor data.</p>
    <table class="kel" id="kel">
      <thead><tr><th>Proyek</th><th style="width:200px">Tipe</th><th style="width:270px">Proyek induk</th></tr></thead>
      <tbody>
        <% projects.forEach(function (p) { %>
          <tr data-id="<%= p.id %>" class="<%= p.type === 'SUB' ? 'sub' : '' %>">
            <td><b><%= p.name %></b><% if (!p.active) { %><span class="tag">belum ada data</span><% } %><span class="pid"><%= p.id %><%= p.team ? ' · ' + p.team : '' %></span></td>
            <td data-l="Tipe">
              <select class="t" aria-label="Tipe <%= p.name %>">
                <option value="PENGEMBANGAN" <%= p.type === 'PENGEMBANGAN' ? 'selected' : '' %>>Pengembangan</option>
                <option value="RUTIN" <%= p.type === 'RUTIN' ? 'selected' : '' %>>Rutin</option>
                <option value="SUB" <%= p.type === 'SUB' ? 'selected' : '' %>>Sub-proyek</option>
              </select>
            </td>
            <td data-l="Proyek induk">
              <select class="p" aria-label="Proyek induk <%= p.name %>" data-cur="<%= p.parent %>"></select>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="savebar">
      <button class="btn" id="saveBtn" type="button" disabled>Simpan kelompok</button>
      <span class="changed" id="changed" hidden>Ada perubahan yang belum disimpan.</span>
    </div>
    <div class="err" id="err" role="alert"></div>
    <div class="ok" id="ok" role="status"></div>
  <% } %>
</div>

<script>
(function () {
  var table = document.getElementById('kel');
  if (!table) return;
  var names = {};
  <% projects.forEach(function (p) { %>names[<%- JSON.stringify(p.id) %>] = <%- JSON.stringify(p.name) %>;<% }) %>
  var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
  var btn = document.getElementById('saveBtn'), changed = document.getElementById('changed');
  var err = document.getElementById('err'), ok = document.getElementById('ok');
  var initial = JSON.stringify(state());

  function state() {
    return rows.map(function (tr) {
      var t = tr.querySelector('.t').value, p = tr.querySelector('.p');
      return { id: tr.getAttribute('data-id'), type: t, parent: t === 'SUB' ? (p.value || p.getAttribute('data-cur') || '') : '' };
    });
  }
  function refresh() {
    var dev = rows.filter(function (tr) { return tr.querySelector('.t').value === 'PENGEMBANGAN'; }).map(function (tr) { return tr.getAttribute('data-id'); });
    rows.forEach(function (tr) {
      var id = tr.getAttribute('data-id'), t = tr.querySelector('.t').value, sel = tr.querySelector('.p');
      var cur = sel.value || sel.getAttribute('data-cur') || '';
      tr.classList.toggle('sub', t === 'SUB');
      if (t !== 'SUB') { sel.innerHTML = '<option value="">—</option>'; sel.disabled = true; return; }
      sel.disabled = false;
      var opts = '<option value="">Pilih proyek induk…</option>';
      dev.filter(function (d) { return d !== id; }).forEach(function (d) {
        opts += '<option value="' + d + '"' + (d === cur ? ' selected' : '') + '>' + String(names[d] || d).replace(/</g, '&lt;') + '</option>';
      });
      sel.innerHTML = opts;
      sel.setAttribute('data-cur', sel.value);
    });
    var dirty = JSON.stringify(state()) !== initial;
    btn.disabled = !dirty;
    changed.hidden = !dirty;
  }
  table.addEventListener('change', function (e) {
    if (e.target.classList.contains('p')) e.target.setAttribute('data-cur', e.target.value);
    ok.textContent = ''; err.textContent = '';
    refresh();
  });
  btn.addEventListener('click', async function () {
    err.textContent = ''; ok.textContent = '';
    var data = state();
    var miss = data.filter(function (x) { return x.type === 'SUB' && !x.parent; });
    if (miss.length) { err.textContent = 'Pilih proyek induk untuk: ' + miss.map(function (x) { return names[x.id] || x.id; }).join(', ') + '.'; return; }
    btn.disabled = true;
    try {
      var res = await fetch('/api/admin/kelompok', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ rows: data }) });
      var json = await res.json();
      if (!json.ok) throw new Error(json.error || 'Gagal menyimpan.');
      initial = JSON.stringify(state());
      refresh();
      ok.textContent = 'Kelompok proyek tersimpan. Portal langsung memakai pengelompokan ini.';
    } catch (ex) {
      err.textContent = ex.message;
      refresh();
    }
  });
  refresh();
})();
</script>
