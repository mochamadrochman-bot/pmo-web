<div class="card">
  <h1>Ganti Password</h1>
  <% if (user.must_change_password) { %>
    <p class="sub">Akun Anda memakai password sementara dari Admin. Buat password baru sebelum melanjutkan.</p>
  <% } else { %>
    <p class="sub">Setelah diganti, perangkat lain yang masih login dengan akun ini akan dikeluarkan.</p>
  <% } %>
  <form id="pwForm">
    <label for="current"><%= user.must_change_password ? 'Password sementara' : 'Password lama' %></label>
    <input id="current" type="password" autocomplete="current-password" required />
    <label for="next">Password baru</label>
    <input id="next" type="password" autocomplete="new-password" minlength="<%= minLength %>" required />
    <div style="font-size:12px;color:var(--muted);margin-top:4px">Minimal <%= minLength %> karakter, tidak sama dengan username.</div>
    <label for="confirm">Ulangi password baru</label>
    <input id="confirm" type="password" autocomplete="new-password" required />
    <button class="primary" type="submit">Simpan password baru</button>
    <div class="err" id="err" role="alert"></div>
    <div id="ok" style="color:#166534;font-size:13px;margin-top:12px" role="status"></div>
  </form>
</div>

<script>
  (function () {
    var form = document.getElementById('pwForm');
    var err = document.getElementById('err');
    var ok = document.getElementById('ok');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      err.textContent = '';
      ok.textContent = '';
      var next = form.next.value;
      if (next !== form.confirm.value) {
        err.textContent = 'Ulangan password baru tidak sama.';
        return;
      }
      var btn = form.querySelector('button');
      btn.disabled = true;
      try {
        var res = await fetch('/api/auth/password', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ current: form.current.value, next: next }),
        });
        var json = await res.json();
        if (!json.ok) throw new Error(json.error || 'Gagal menyimpan.');
        ok.textContent = 'Password sudah diganti. Mengalihkan ke Portal…';
        form.reset();
        setTimeout(function () { location.href = '/'; }, 1200);
      } catch (ex) {
        err.textContent = ex.message;
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>
