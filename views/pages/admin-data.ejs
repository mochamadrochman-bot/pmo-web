<style>
  .panel { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin: 0 0 18px; }
  .panel h2 { font-size: 16px; margin: 0 0 6px; color: var(--navy); }
  .muted { color: var(--muted); }
  ol.langkah { margin: 8px 0 0 18px; padding: 0; font-size: 14px; }
  ol.langkah li { margin: 4px 0; }
  .drop { margin-top: 14px; border: 2px dashed var(--line); border-radius: 12px; padding: 22px; text-align: center; background: #fbfcfd; }
  .drop.over { border-color: var(--teal); background: #f0fdfa; }
  .btn { padding: 9px 16px; border-radius: 8px; border: 0; background: var(--navy); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .btn:disabled { opacity: .5; cursor: default; }
  .ok { color: #166534; font-size: 14px; margin-top: 12px; }
  table.sheets td, table.sheets th { font-size: 13px; padding: 6px 10px; }
  .warn { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-top: 12px; }
</style>

<h1>Impor Data</h1>
<p class="sub">Isi spreadsheet PMO DASHBOARD yang dipakai halaman Portal, Executive, Weekly, dan modul lain.</p>

<style>
  .modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; margin-top: 10px; }
  .mode { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; cursor: pointer; background: #fff; }
  .mode.on { border-color: var(--teal); box-shadow: 0 0 0 2px #99f6e4; background: #f0fdfa; }
  .mode b { display: block; color: var(--navy); margin-bottom: 4px; }
  .mode small { color: var(--muted); font-size: 13px; line-height: 1.4; display: block; }
  .mode input { width: auto; margin: 0 6px 0 0; }
</style>
<div class="panel">
  <h2>Mode data</h2>
  <p class="muted" style="margin:0;font-size:13px">Menentukan dari mana data dashboard berasal dan apakah input boleh dilakukan di server ini.</p>
  <div class="modes" id="modes">
    <label class="mode <%= sync.mode === 'baca' ? 'on' : '' %>"><b><input type="radio" name="mode" value="baca" <%= sync.mode === 'baca' ? 'checked' : '' %>>Baca</b>
      <small>Input di aplikasi lama. Server mengikuti Google Sheets otomatis. Aman untuk sekarang.</small></label>
    <label class="mode <%= sync.mode === 'uji' ? 'on' : '' %>"><b><input type="radio" name="mode" value="uji" <%= sync.mode === 'uji' ? 'checked' : '' %>>Uji coba</b>
      <small>Input di server ini aktif untuk dicoba. Sinkron berhenti. Kembali ke Baca = data uji dibuang dan diganti data Google terbaru.</small></label>
    <label class="mode <%= sync.mode === 'produksi' ? 'on' : '' %>"><b><input type="radio" name="mode" value="produksi" <%= sync.mode === 'produksi' ? 'checked' : '' %>>Produksi</b>
      <small>Server ini menjadi sumber data utama. Aplikasi lama tidak dipakai lagi untuk input. Sinkron dan impor mati.</small></label>
  </div>
  <div style="margin-top:12px"><button class="btn" id="modeBtn" type="button" disabled>Terapkan mode</button></div>
  <div class="err" id="modeErr" role="alert"></div>
  <div class="ok" id="modeOk" role="status"></div>
</div>

<div class="panel">
  <h2>Sinkron dari Google Sheets</h2>
  <% if (!google.connected) { %>
    <p class="muted" style="margin:0">Akun Google belum dihubungkan. Buka <a href="/admin/google">Koneksi Google</a> dulu, atau pakai unggah manual di bawah.</p>
  <% } else { %>
    <p style="margin:0 0 6px;font-size:14px">
      <% if (sync.auto) { %>Otomatis setiap <b><%= sync.minutes %> menit</b>, hanya bila spreadsheet berubah.<% } else if (sync.mode === 'uji') { %>Sinkron otomatis <b>berhenti</b> selama mode uji coba. Tombol di bawah mengembalikan data ke versi Google Sheets.<% } else if (sync.mode === 'produksi') { %>Mode produksi: sinkron <b>mati</b>.<% } else { %>Sinkron otomatis <b>mati</b>.<% } %>
    </p>
    <% if (sync.lastResult) { %>
      <p class="muted" style="margin:0;font-size:13px">Pemeriksaan terakhir: <%= new Date(sync.lastResult.at).toLocaleString('id-ID', { timeZone: 'Asia/Bangkok' }) %> ·
        <%= sync.lastResult.status === 'synced' ? 'data diperbarui' : sync.lastResult.status === 'unchanged' ? 'tidak ada perubahan' : 'gagal: ' + sync.lastResult.error %></p>
    <% } %>
    <% if (sync.mode !== 'produksi') { %><div style="margin-top:12px"><button class="btn" id="syncBtn" type="button"><%= sync.mode === 'uji' ? 'Kembalikan ke data Google Sheets' : 'Sinkron sekarang' %></button></div><% } %>
    <div class="err" id="syncErr" role="alert"></div>
    <div class="ok" id="syncOk" role="status"></div>
  <% } %>
</div>

<div class="panel">
  <h2>Unggah spreadsheet (manual)</h2>
  <ol class="langkah">
    <li>Buka spreadsheet <b>PMO DASHBOARD</b> di Google Sheets.</li>
    <li>Menu <b>File → Download → Microsoft Excel (.xlsx)</b>.</li>
    <li>Pilih atau seret berkas itu ke kotak di bawah, lalu klik <b>Impor</b>.</li>
  </ol>
  <div class="warn">Impor <b>mengganti seluruh</b> data spreadsheet di server dengan isi berkas. Perubahan yang dibuat lewat aplikasi baru setelah impor terakhir akan tertimpa.</div>
  <div class="drop" id="drop">
    <input type="file" id="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    <div style="margin-top:12px"><button class="btn" id="go" disabled>Impor</button></div>
    <div class="err" id="err" role="alert"></div>
    <div class="ok" id="ok" role="status"></div>
  </div>
</div>

<div class="panel">
  <h2>Animasi pembuka login</h2>
  <p class="muted" style="margin:0 0 10px;font-size:13px">Animasi stop-motion 5 detik saat membuka Portal setelah login (berlaku untuk semua akun).</p>
  <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer">
    <input type="checkbox" id="introToggle" <%= introEnabled ? 'checked' : '' %> style="width:auto;margin:0;cursor:pointer" />
    <span>Tampilkan animasi pembuka setelah login</span>
  </label>
  <div class="err" id="introErr" role="alert"></div>
  <div class="ok" id="introOk" role="status"></div>
</div>

<div class="panel">
  <h2>Backup &amp; pulihkan data aplikasi (.json)</h2>
  <p class="muted" style="margin:0 0 12px;font-size:13px">Unduh salinan seluruh data spreadsheet, kelompok proyek, dan pengaturan ke laptop Anda, atau pulihkan kembali dari berkas backup <code>.json</code>.</p>
  <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
    <a class="btn" href="/api/admin/backup" style="text-decoration:none;display:inline-block">Unduh Backup (.json)</a>
  </div>
  <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
    <label for="restoreFile" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Pulihkan dari berkas backup (.json)</label>
    <input type="file" id="restoreFile" accept=".json,application/json" />
    <div style="margin-top:10px"><button class="btn" id="restoreBtn" type="button" disabled>Pulihkan Backup</button></div>
    <div class="warn" style="margin-top:10px">Pemulihan akan mengganti seluruh data spreadsheet dan kelompok proyek saat ini dengan isi berkas backup.</div>
    <div class="err" id="restoreErr" role="alert"></div>
    <div class="ok" id="restoreOk" role="status"></div>
  </div>
</div>

<div class="panel">
  <h2>Data saat ini</h2>
  <% if (last) { %>
    <p class="muted" style="margin:0 0 10px">Impor terakhir: <%= new Date(last.at).toLocaleString('id-ID', { timeZone: 'Asia/Bangkok' }) %> oleh <%= last.actor || '—' %><%= last.file_name ? ' · ' + last.file_name : '' %></p>
  <% } %>
  <% if (!sheets.length) { %>
    <div class="empty">Belum ada data. Unggah spreadsheet lebih dulu.</div>
  <% } else { %>
    <table class="sheets"><thead><tr><th>Sheet</th><th>Baris</th><th>Kolom</th></tr></thead><tbody>
      <% sheets.forEach(function (s) { %><tr><td><%= s.name %></td><td><%= s.rows %></td><td><%= s.cols %></td></tr><% }); %>
    </tbody></table>
  <% } %>
</div>

<script>
(function () {
  var current = <%- JSON.stringify(sync.mode) %>, btn = document.getElementById('modeBtn');
  var pick = function () { var r = document.querySelector('input[name=mode]:checked'); return r ? r.value : current; };
  document.querySelectorAll('input[name=mode]').forEach(function (r) {
    r.addEventListener('change', function () {
      document.querySelectorAll('.mode').forEach(function (m) { m.classList.toggle('on', m.contains(r) && r.checked); });
      btn.disabled = pick() === current;
    });
  });
  btn.addEventListener('click', async function () {
    var m = pick(), e = document.getElementById('modeErr'), o = document.getElementById('modeOk'), body = { mode: m };
    e.textContent = ''; o.textContent = '';
    if (m === 'uji' && !confirm('Aktifkan mode uji coba? Sinkron otomatis berhenti dan input di server ini aktif.')) return;
    if (m === 'baca' && current === 'uji' && !confirm('Kembali ke mode Baca? Semua data yang diisi selama uji coba dibuang dan diganti data Google Sheets terbaru.')) return;
    if (m === 'produksi') {
      var c = prompt('Mode produksi: server ini menjadi sumber data utama dan aplikasi lama tidak dipakai lagi untuk input. Ketik PINDAH untuk melanjutkan.');
      if (c === null) return;
      body.confirm = c;
    }
    btn.disabled = true; o.textContent = 'Menerapkan…';
    try {
      var j = await (await fetch('/api/admin/mode', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })).json();
      if (!j.ok) throw new Error(j.error || 'Gagal.');
      o.textContent = 'Mode sekarang: ' + j.data.mode + (j.data.restored ? ' · data Google: ' + j.data.restored.status : '') + '. Memuat ulang…';
      setTimeout(function () { location.reload(); }, 1200);
    } catch (x) { o.textContent = ''; e.textContent = x.message; btn.disabled = false; }
  });
})();
(function () {
  var sb = document.getElementById('syncBtn');
  if (sb) sb.addEventListener('click', async function () {
    var e = document.getElementById('syncErr'), o = document.getElementById('syncOk');
    sb.disabled = true; e.textContent = ''; o.textContent = 'Mengunduh spreadsheet dari Google… (bisa sampai 1 menit)';
    try {
      var j = await (await fetch('/api/admin/sync', { method: 'POST' })).json();
      if (!j.ok) throw new Error(j.error || 'Sinkron gagal.');
      o.textContent = 'Berhasil: ' + j.data.sheets + ' sheet diperbarui. Memuat ulang…';
      setTimeout(function () { location.reload(); }, 1200);
    } catch (x) { o.textContent = ''; e.textContent = x.message; sb.disabled = false; }
  });
})();
(function () {
  var file = document.getElementById('file'), go = document.getElementById('go');
  var err = document.getElementById('err'), ok = document.getElementById('ok'), drop = document.getElementById('drop');
  file.addEventListener('change', function () { go.disabled = !file.files.length; err.textContent = ''; ok.textContent = ''; });
  ['dragover', 'dragenter'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('over'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function () { drop.classList.remove('over'); }); });
  drop.addEventListener('drop', function (e) { e.preventDefault(); if (e.dataTransfer.files.length) { file.files = e.dataTransfer.files; go.disabled = false; } });
  go.addEventListener('click', async function () {
    var f = file.files[0];
    if (!f) return;
    if (!/\.xlsx$/i.test(f.name)) { err.textContent = 'Pilih berkas .xlsx.'; return; }
    if (!confirm('Ganti seluruh data spreadsheet di server dengan isi ' + f.name + '?')) return;
    go.disabled = true; err.textContent = ''; ok.textContent = 'Mengunggah dan membaca berkas… (bisa sampai 1 menit)';
    try {
      var res = await fetch('/api/admin/import-xlsx', { method: 'POST', headers: { 'content-type': 'application/octet-stream', 'x-file-name': encodeURIComponent(f.name) }, body: f });
      var j = await res.json();
      if (!j.ok) throw new Error(j.error || 'Impor gagal.');
      ok.textContent = 'Berhasil: ' + j.data.sheets + ' sheet dimuat. Memuat ulang halaman…';
      setTimeout(function () { location.reload(); }, 1500);
    } catch (e) {
      ok.textContent = ''; err.textContent = e.message; go.disabled = false;
    }
  });
})();
(function () {
  var cb = document.getElementById('introToggle'), err = document.getElementById('introErr'), ok = document.getElementById('introOk');
  if (!cb) return;
  cb.addEventListener('change', async function () {
    err.textContent = ''; ok.textContent = 'Menyimpan…'; cb.disabled = true;
    try {
      var j = await (await fetch('/api/admin/intro', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ enabled: cb.checked }) })).json();
      if (!j.ok) throw new Error(j.error || 'Gagal menyimpan.');
      ok.textContent = j.data.enabled ? 'Animasi pembuka diaktifkan.' : 'Animasi pembuka dinonaktifkan.';
    } catch (e) {
      ok.textContent = ''; err.textContent = e.message; cb.checked = !cb.checked;
    } finally {
      cb.disabled = false;
    }
  });
})();
(function () {
  var rf = document.getElementById('restoreFile'), rb = document.getElementById('restoreBtn');
  var err = document.getElementById('restoreErr'), ok = document.getElementById('restoreOk');
  if (!rf || !rb) return;
  rf.addEventListener('change', function () { rb.disabled = !rf.files.length; err.textContent = ''; ok.textContent = ''; });
  rb.addEventListener('click', async function () {
    var f = rf.files[0];
    if (!f) return;
    if (!/\.json$/i.test(f.name)) { err.textContent = 'Pilih berkas backup .json.'; return; }
    if (!confirm('Pulihkan seluruh data dari ' + f.name + '? Data spreadsheet dan kelompok proyek saat ini akan diganti.')) return;
    rb.disabled = true; err.textContent = ''; ok.textContent = 'Memulihkan data dari backup…';
    try {
      var res = await fetch('/api/admin/restore', { method: 'POST', headers: { 'content-type': 'application/octet-stream', 'x-file-name': encodeURIComponent(f.name) }, body: f });
      var j = await res.json();
      if (!j.ok) throw new Error(j.error || 'Pemulihan gagal.');
      ok.textContent = 'Berhasil dipulihkan: ' + j.data.sheets + ' sheet dimuat. Memuat ulang…';
      setTimeout(function () { location.reload(); }, 1500);
    } catch (e) {
      ok.textContent = ''; err.textContent = e.message; rb.disabled = false;
    }
  });
})();
</script>
