<style>
  .steps-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 16px; }
  .step-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 8px;
  }
  .step-card h2 { font-size: 14.5px; margin: 0; color: var(--navy); display: flex; align-items: center; gap: 8px; }
  .step {
    display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    background: var(--pri); color: #fff; font-size: 11.5px; font-weight: 700; flex: none;
  }
  .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 10px; margin-bottom: 14px; }
  .stat { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; box-shadow: var(--shadow); }
  .stat b { display: block; font-size: 18px; color: var(--navy); }
  .stat span { font-size: 12px; color: var(--muted); }
  .bar { height: 8px; border-radius: 99px; background: var(--bg); border: 1px solid var(--line); overflow: hidden; margin-top: 8px; }
  .bar i { display: block; height: 100%; background: var(--pri); }
  .bar i.need { background: var(--warn); }
  .filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip {
    padding: 5px 12px; border-radius: 7px; border: 1px solid var(--line);
    background: var(--card); color: var(--muted); font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
  }
  .chip.on { background: var(--pri); color: #fff; border-color: var(--pri); }
  .log { max-height: 220px; overflow: auto; font-size: 12px; background: var(--tint); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin-top: 10px; }
  .log div.f { color: var(--err); }
  .confirm { border: 1px solid var(--warn); background: var(--warn-bg); color: var(--warn); border-radius: 10px; padding: 12px; margin-top: 10px; font-size: 13.5px; }
  .fname { min-width: 240px; max-width: 380px; overflow-wrap: anywhere; }
  .owner { max-width: 200px; overflow-wrap: anywhere; color: var(--muted); }
  .tbl td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 960px) { .steps-row { grid-template-columns: 1fr; } }
</style>

<div class="pg-head">
  <div>
    <div class="pg-kicker">Manajemen File Weekly</div>
    <h1>Arsip Materi Weekly</h1>
    <p class="sub" style="margin:0">Salin video dan materi weekly dari akun kontraktor atau perorangan ke Google Drive tim proyek, lalu ganti tautannya di dashboard. File asli tidak diubah.</p>
  </div>
  <div class="row">
    <select id="pid" aria-label="Pilih proyek" style="width:auto;min-width:230px">
      <% projects.forEach(function (p) { %><option value="<%= p.id %>" <%= p.id === sel ? 'selected' : '' %>><%= p.name %></option><% }) %>
    </select>
    <button class="btn" id="reload" type="button">Muat ulang</button>
  </div>
</div>

<% if (msg) { %><div class="msg ok"><%= msg %></div><% } %>
<% if (err) { %><div class="msg err"><%= err %></div><% } %>
<% if (!configured) { %><div class="msg err">Koneksi Google belum disetel di server (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET).</div><% } %>

<div class="steps-row">
  <div class="step-card">
    <h2><span class="step">1</span> Akun Google tim proyek</h2>
    <div id="acc" class="muted" style="font-size:13px">Memuat…</div>
  </div>

  <div class="step-card">
    <h2><span class="step">2</span> Folder tujuan arsip</h2>
    <p class="muted" style="margin:0;font-size:12.5px">Tempel tautan folder Drive milik tim. Di dalamnya dibuat subfolder per minggu (W103, W104, …).</p>
    <div class="row">
      <input type="text" id="folder" placeholder="https://drive.google.com/drive/folders/…" aria-label="Tautan folder tujuan" style="flex:1;min-width:140px">
      <button class="btn" id="saveFolder" type="button">Simpan</button>
    </div>
    <div id="folderInfo" class="muted" style="font-size:12.5px"></div>
  </div>

  <div class="step-card">
    <h2><span class="step">3</span> Periksa lalu arsipkan</h2>
    <div id="quota" style="font-size:12.5px"></div>
    <div class="row" style="margin-top:auto">
      <button class="btn pri" id="go" type="button" disabled>Mulai arsip…</button>
      <button class="btn" id="undo" type="button">Pulihkan tautan lama…</button>
    </div>
    <div id="confirm"></div>
    <div id="job"></div>
  </div>
</div>

<div class="stats" id="stats"></div>

<div class="panel" style="padding:14px 18px">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
    <h2 style="margin:0">Daftar video &amp; materi</h2>
    <div class="filters" id="filters"></div>
  </div>
  <div class="tblwrap" style="border:1px solid var(--line);border-radius:10px">
    <table class="tbl">
      <thead><tr><th>Minggu</th><th>Jenis</th><th>File</th><th style="text-align:right">Ukuran</th><th>Pemilik</th><th>Status</th><th></th></tr></thead>
      <tbody id="rows"><tr><td colspan="7" class="muted">Memuat…</td></tr></tbody>
    </table>
  </div>
  <input type="file" id="picker" hidden>
</div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var pid = $('pid').value, data = null, filter = 'semua', poll = null, upCell = null;
  var ST = {
    tim: ['Sudah di Drive tim', 'b-tim'], salin: ['Akan disalin', 'b-salin'],
    onedrive: ['OneDrive · unggah manual', 'b-manual'], akses: ['Tak bisa diakses · unggah manual', 'b-err'],
    folder: ['Tautan folder · unggah manual', 'b-manual'], lain: ['Tautan lain', 'b-off'], 'belum-cek': ['Belum dicek', 'b-off']
  };
  var MANUAL = { onedrive: 1, akses: 1, folder: 1, lain: 1 };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
  function gb(n) { if (n == null) return '–'; if (n < 1e9) return (n / 1e6).toFixed(n < 1e7 ? 1 : 0).replace('.', ',') + ' MB'; return (n / 1e9).toFixed(2).replace('.', ',') + ' GB'; }
  async function api(path, body) {
    var r = await fetch('/api/arsip/' + encodeURIComponent(pid) + path, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : {});
    var j = await r.json().catch(function () { return { ok: false, error: 'HTTP ' + r.status }; });
    if (!j.ok) throw new Error(j.error || 'Gagal');
    return j.data;
  }

  async function load() {
    $('rows').innerHTML = '<tr><td colspan="7" class="muted">Memeriksa file di Google Drive…</td></tr>';
    try { data = await api(''); } catch (e) { $('rows').innerHTML = '<tr><td colspan="7" class="msg err">' + esc(e.message) + '</td></tr>'; return; }
    render();
    if (data.job && data.job.running) startPoll();
  }

  function render() {
    var a = data.account;
    if (!a) {
      $('acc').innerHTML = '<p style="margin:0 0 8px">Belum terhubung. Masuk dengan akun Google <b>tim proyek</b> (bukan pribadi/kontraktor). Bila muncul peringatan "belum diverifikasi", pilih <b>Advanced → Go to PMO Dashboard</b>.</p><a class="btn pri sm" href="/arsip/google/connect?pid=' + encodeURIComponent(pid) + '">Hubungkan akun Google tim</a>';
    } else {
      $('acc').innerHTML = '<div style="margin-bottom:8px"><span class="badge b-tim">Terhubung</span> <b style="color:var(--navy)">' + esc(a.email || 'akun Google') + '</b></div>' +
        (data.tokenError ? '<div class="msg err" style="margin-bottom:8px">' + esc(data.tokenError) + '</div>' : '') +
        '<div class="row"><a class="btn sm" href="/arsip/google/connect?pid=' + encodeURIComponent(pid) + '">Ganti akun</a><button class="btn sm danger" id="disc" type="button">Putuskan</button></div>';
      $('disc').onclick = async function () { try { await api('/disconnect', {}); load(); } catch (e) { alertBox(e.message); } };
    }
    $('folder').disabled = $('saveFolder').disabled = !a;
    $('folderInfo').innerHTML = a && a.folderId ? 'Folder tujuan: <a href="https://drive.google.com/drive/folders/' + esc(a.folderId) + '" target="_blank" rel="noopener"><b>' + esc(a.folderName || a.folderId) + '</b></a>' : (a ? 'Belum ada folder tujuan.' : '');

    var c = {}, sz = {}, seen = {};
    data.items.forEach(function (x) { c[x.status] = (c[x.status] || 0) + 1; if (x.size && !seen[x.status + x.fileId]) { seen[x.status + x.fileId] = 1; sz[x.status] = (sz[x.status] || 0) + x.size; } });
    var man = (c.onedrive || 0) + (c.akses || 0) + (c.folder || 0) + (c.lain || 0);
    if (!a) {
      $('stats').innerHTML = stat(data.items.length, 'tautan video & materi') + stat((c.onedrive || 0) + (c.folder || 0) + (c.lain || 0), 'di luar Google Drive');
      $('quota').innerHTML = '<div class="muted">Hubungkan akun Google tim untuk melihat ukuran, pemilik, dan file yang perlu disalin.</div>';
      $('go').disabled = true; renderFilters(c); renderRows(); renderJob(data.job); return;
    }
    $('stats').innerHTML =
      stat(data.items.length, 'tautan video & materi') +
      stat(c.tim || 0, 'sudah di Drive tim · ' + gb(sz.tim || 0)) +
      stat(c.salin || 0, 'akan disalin · ' + gb(data.need)) +
      stat(man, 'perlu unggah manual');
    var q = data.quota;
    if (q && q.limit) {
      var free = Math.max(0, q.limit - q.usage), pctU = Math.min(100, q.usage / q.limit * 100), pctN = Math.min(100 - pctU, data.need / q.limit * 100);
      $('quota').innerHTML = '<div class="muted">Drive tim: terpakai ' + gb(q.usage) + ' / ' + gb(q.limit) + ' · sisa ' + gb(free) + '</div><div class="bar" style="display:flex"><i style="width:' + pctU + '%"></i><i class="need" style="width:' + pctN + '%"></i></div>' +
        (free < data.need ? '<div class="msg err" style="margin-top:8px">Ruang tidak cukup: perlu ' + gb(data.need) + ', sisa ' + gb(free) + '.</div>' : '<div class="muted" style="margin-top:4px;font-size:11.5px">Kuning = perkiraan tambahan dari arsip ini.</div>');
    } else if (q) { $('quota').innerHTML = '<div class="muted">Drive tim: tanpa batas (terpakai ' + gb(q.usage) + ').</div>'; }
    else $('quota').innerHTML = '';
    var running = data.job && data.job.running;
    $('go').disabled = !(a && a.folderId && c.salin && !running && !data.tokenError);
    renderFilters(c); renderRows(); renderJob(data.job);
  }
  function stat(n, t) { return '<div class="stat"><b>' + n + '</b><span>' + esc(t) + '</span></div>'; }

  function renderFilters(c) {
    var opts = [['semua', 'Semua'], ['salin', 'Akan disalin'], ['manual', 'Unggah manual'], ['tim', 'Sudah di Drive tim']];
    $('filters').innerHTML = opts.map(function (o) { return '<button type="button" class="chip' + (filter === o[0] ? ' on' : '') + '" data-f="' + o[0] + '">' + o[1] + '</button>'; }).join('');
    $('filters').querySelectorAll('.chip').forEach(function (b) { b.onclick = function () { filter = b.dataset.f; renderFilters(c); renderRows(); }; });
  }

  function renderRows() {
    var list = data.items.filter(function (x) { return filter === 'semua' || (filter === 'manual' ? MANUAL[x.status] : x.status === filter); });
    list.sort(function (a, b) { return (parseInt(a.week.slice(1)) || 0) - (parseInt(b.week.slice(1)) || 0) || a.item.localeCompare(b.item); });
    if (!list.length) { $('rows').innerHTML = '<tr><td colspan="7" class="muted">Tidak ada tautan untuk filter ini.</td></tr>'; return; }
    var canUp = data.account && data.account.folderId && !data.tokenError;
    $('rows').innerHTML = list.map(function (x) {
      var s = ST[x.status] || [x.status, 'b-off'];
      var act = '<a class="btn sm" href="' + esc(x.url) + '" target="_blank" rel="noopener">Buka</a>';
      if (MANUAL[x.status] && canUp) act += ' <button class="btn sm" type="button" data-up="' + x.row + ',' + x.col + '">Unggah file</button>';
      return '<tr><td>' + esc(x.week) + '</td><td>' + (x.item === 'VIDEO' ? 'Video' : 'Materi') + '</td><td class="fname">' + esc(x.title || (x.kind === 'onedrive' ? 'Tautan OneDrive' : x.url)) +
        (x.error ? '<div class="muted">' + esc(x.error) + '</div>' : '') + '</td><td class="num">' + gb(x.size) + '</td><td class="owner">' + esc(x.owner || '–') + '</td><td><span class="badge ' + s[1] + '">' + s[0] + '</span><span class="up-st" id="up-' + x.row + '-' + x.col + '"></span></td><td style="white-space:nowrap">' + act + '</td></tr>';
    }).join('');
    $('rows').querySelectorAll('[data-up]').forEach(function (b) { b.onclick = function () { upCell = b.dataset.up.split(',').map(Number); $('picker').value = ''; $('picker').click(); }; });
  }

  function renderJob(j) {
    if (!j) { $('job').innerHTML = ''; return; }
    var pct = j.total ? Math.round(j.done / j.total * 100) : 0;
    $('job').innerHTML = '<div class="muted" style="margin-top:8px">' + (j.running ? 'Sedang mengarsipkan' + (j.current ? ': ' + esc(j.current) : '') + '…' : 'Arsip selesai.') + ' ' + j.done + '/' + j.total + ' · berhasil ' + j.ok + ' · gagal ' + j.fail + '</div><div class="bar"><i style="width:' + pct + '%"></i></div>' +
      (j.error ? '<div class="msg err" style="margin-top:8px">' + esc(j.error) + '</div>' : '') +
      (j.log && j.log.length ? '<div class="log">' + j.log.map(function (l) { return '<div class="' + (l.ok ? '' : 'f') + '">' + (l.ok ? '✓ ' : '✗ ') + esc(l.text) + '</div>'; }).join('') + '</div>' : '');
  }

  function startPoll() {
    clearInterval(poll);
    poll = setInterval(async function () {
      try {
        var j = await api('/job');
        renderJob(j);
        if (!j || !j.running) { clearInterval(poll); load(); }
      } catch (e) { clearInterval(poll); }
    }, 2500);
  }

  function alertBox(t, ok) { $('confirm').innerHTML = '<div class="msg ' + (ok ? 'ok' : 'err') + '" style="margin-top:10px">' + esc(t) + '</div>'; }

  $('go').onclick = function () {
    var n = data.items.filter(function (x) { return x.status === 'salin'; }).length;
    $('confirm').innerHTML = '<div class="confirm"><b>Salin ' + n + ' tautan (' + gb(data.need) + ')</b> ke folder <b>' + esc(data.account.folderName || '') + '</b> milik ' + esc(data.account.email || '') + '?<br>File asli tetap ada.<div class="row" style="margin-top:8px"><button class="btn pri sm" id="yes" type="button">Ya, mulai arsip</button><button class="btn sm" id="no" type="button">Batal</button></div></div>';
    $('no').onclick = function () { $('confirm').innerHTML = ''; };
    $('yes').onclick = async function () {
      this.disabled = true;
      try { var j = await api('/start', { confirm: 'ARSIP' }); $('confirm').innerHTML = ''; $('go').disabled = true; renderJob(j); startPoll(); } catch (e) { alertBox(e.message); }
    };
  };

  $('undo').onclick = function () {
    $('confirm').innerHTML = '<div class="confirm">Kembalikan semua tautan proyek ini ke tautan sebelum diarsipkan? Salinan di Drive tim tidak dihapus.<div class="row" style="margin-top:8px"><button class="btn pri sm" id="yes2" type="button">Ya, pulihkan</button><button class="btn sm" id="no2" type="button">Batal</button></div></div>';
    $('no2').onclick = function () { $('confirm').innerHTML = ''; };
    $('yes2').onclick = async function () {
      this.disabled = true;
      try { var r = await api('/restore', { confirm: 'PULIHKAN' }); alertBox(r.restored + ' tautan dikembalikan ke tautan lama.', true); load(); } catch (e) { alertBox(e.message); }
    };
  };

  $('saveFolder').onclick = async function () {
    var b = this; b.disabled = true;
    try { var f = await api('/folder', { url: $('folder').value }); $('folder').value = ''; alertBox('Folder tujuan disimpan: ' + f.name, true); await load(); } catch (e) { $('folderInfo').innerHTML = '<span style="color:var(--err)">' + esc(e.message) + '</span>'; }
    b.disabled = false;
  };

  $('picker').onchange = async function () {
    var f = this.files && this.files[0]; if (!f || !upCell) return;
    var cell = upCell, st = $('up-' + cell[0] + '-' + cell[1]);
    var show = function (t) { if (st) st.innerHTML = '<div class="muted">' + esc(t) + '</div>'; };
    try {
      show('Menyiapkan unggahan…');
      var s = await api('/upload-session', { row: cell[0], col: cell[1], name: f.name, size: f.size, type: f.type });
      var res = await new Promise(function (ok, no) {
        var x = new XMLHttpRequest();
        x.open('PUT', s.uploadUrl);
        x.upload.onprogress = function (e) { if (e.lengthComputable) show('Mengunggah ' + Math.round(e.loaded / e.total * 100) + '% (' + gb(e.loaded) + ' / ' + gb(e.total) + ')'); };
        x.onload = function () { if (x.status >= 200 && x.status < 300) { try { ok(JSON.parse(x.responseText)); } catch (e) { no(new Error('Jawaban Google tidak terbaca.')); } } else no(new Error('Unggah gagal (HTTP ' + x.status + ').')); };
        x.onerror = function () { no(new Error('Koneksi terputus saat mengunggah.')); };
        x.send(f);
      });
      show('Memperbarui tautan…');
      await api('/upload-done', { row: cell[0], col: cell[1], fileId: res.id });
      show('Selesai, tautan sudah diganti.');
      setTimeout(load, 800);
    } catch (e) { show('Gagal: ' + e.message); }
  };

  $('pid').onchange = function () { pid = this.value; history.replaceState(null, '', '/arsip?pid=' + encodeURIComponent(pid)); clearInterval(poll); $('confirm').innerHTML = ''; load(); };
  $('reload').onclick = load;
  load();
})();
</script>
