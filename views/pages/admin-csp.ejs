<style>
  .note { font-size: 13px; color: var(--muted); margin: 6px 0 0; line-height: 1.6; }
  td.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 700; }
  details summary { cursor: pointer; font-size: 13px; color: var(--pri-ink); font-weight: 600; }
</style>

<div class="pg-head">
  <div>
    <div class="pg-kicker">Keamanan Browser</div>
    <h1>Laporan CSP</h1>
    <p class="sub" style="margin:0">Content-Security-Policy membatasi dari mana halaman boleh memuat skrip, gambar, video, dan bingkai.</p>
  </div>
  <% if (rows.length) { %><button class="btn danger" id="clr" type="button">Kosongkan catatan</button><% } %>
</div>

<div class="panel">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <h2 style="margin:0">Status Kebijakan:</h2>
    <% if (mode === 'enforce') { %><span class="badge enf">Ditegakkan</span><% } else if (mode === 'off') { %><span class="badge off">Mati</span><% } else { %><span class="badge rep">Mode lapor saja</span><% } %>
  </div>
  <% if (mode !== 'enforce' && mode !== 'off') { %>
  <p class="note">Browser <b>tidak memblokir apa pun</b>. Setiap kali ada sumber di luar daftar, browser mengirim laporan dan tercatat di bawah.
    Biarkan beberapa hari sambil dashboard dipakai seperti biasa (presentasi, video, galeri, CCTV, unggah file). Kalau daftar di bawah kosong atau hanya berisi sumber yang memang tidak dipakai, kebijakan siap ditegakkan.</p>
  <% } %>
  <details style="margin-top:12px"><summary>Lihat kebijakan yang dipakai</summary><p style="margin:8px 0 0"><code><%= policy %></code></p></details>
</div>

<% if (!rows.length) { %>
  <div class="panel">
    <h2 style="margin-bottom:4px">0 jenis pelanggaran tercatat</h2>
    <p class="note" style="margin-top:0">Belum ada laporan. Ini kabar baik, atau dashboard belum banyak dibuka sejak fitur ini aktif.</p>
  </div>
<% } else { %>
  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="cspSearch" type="search" placeholder="Cari directive, domain sumber, atau halaman…" aria-label="Cari laporan CSP">
    </div>
    <span class="tb-count" id="cspCount"><%= rows.length %> jenis pelanggaran tercatat</span>
  </div>
  <div class="tbl-card">
    <div class="tbl-scroll">
      <table id="cspTbl">
        <thead><tr><th>Jenis</th><th>Sumber yang akan terblokir</th><th>Halaman</th><th style="text-align:right">Jumlah</th><th>Terakhir</th></tr></thead>
        <tbody>
        <% rows.forEach(function (r) { %>
          <tr data-q="<%= (r.directive + ' ' + r.blocked + ' ' + r.page + ' ' + (r.sample || '')).toLowerCase() %>">
            <td><code><%= r.directive %></code></td>
            <td><b><%= r.blocked %></b><% if (r.sample) { %><div class="muted" style="font-size:12px;word-break:break-all"><%= r.sample %></div><% } %></td>
            <td><%= r.page %></td><td class="n"><%= r.hits %></td>
            <td class="muted" style="white-space:nowrap"><%= new Date(r.last_seen).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short' }) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<script>
(function () {
  var b = document.getElementById('clr'), q = document.getElementById('cspSearch'), tbl = document.getElementById('cspTbl');
  if (q && tbl) {
    var rows = Array.prototype.slice.call(tbl.querySelectorAll('tbody tr'));
    q.addEventListener('input', function () {
      var v = (q.value || '').trim().toLowerCase(), n = 0;
      rows.forEach(function (tr) { var hit = !v || (tr.getAttribute('data-q') || '').indexOf(v) >= 0; tr.hidden = !hit; if (hit) n++; });
      document.getElementById('cspCount').textContent = 'Menampilkan ' + n + ' dari ' + rows.length + ' jenis';
    });
  }
  if (b) b.onclick = function () {
    if (!confirm('Kosongkan semua catatan laporan CSP?')) return;
    fetch('/api/admin/csp/clear', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' })
      .then(function (r) { return r.json(); }).then(function () { location.reload(); });
  };
})();
</script>
