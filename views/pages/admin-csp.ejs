<style>
  .panel { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin: 0 0 18px; }
  .panel h2 { font-size: 16px; margin: 0 0 6px; color: var(--navy); }
  .note { font-size: 13px; color: var(--muted); margin: 6px 0 0; line-height: 1.6; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .rep { background: #fef3c7; color: #92400e; } .enf { background: #dcfce7; color: #166534; } .off { background: #f1f5f9; color: #475569; }
  .btn { display: inline-block; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--navy); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 7px 8px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  td.n { text-align: right; white-space: nowrap; }
  .wrap { overflow-x: auto; }
  code { background: #f1f5f9; padding: 1px 6px; border-radius: 4px; font-size: 12px; word-break: break-all; }
  details summary { cursor: pointer; font-size: 13px; color: var(--muted); }
  .muted { color: var(--muted); }
</style>

<h1>Laporan CSP</h1>
<p class="sub">Content-Security-Policy membatasi dari mana halaman boleh memuat skrip, gambar, video, dan bingkai.</p>

<div class="panel">
  <h2>Status: <% if (mode === 'enforce') { %><span class="badge enf">Ditegakkan</span><% } else if (mode === 'off') { %><span class="badge off">Mati</span><% } else { %><span class="badge rep">Mode lapor saja</span><% } %></h2>
  <% if (mode !== 'enforce' && mode !== 'off') { %>
  <p class="note">Browser <b>tidak memblokir apa pun</b>. Setiap kali ada sumber di luar daftar, browser mengirim laporan dan tercatat di bawah.
    Biarkan beberapa hari sambil dashboard dipakai seperti biasa (presentasi, video, galeri, CCTV, unggah file). Kalau daftar di bawah kosong atau hanya berisi sumber yang memang tidak dipakai, kebijakan siap ditegakkan.</p>
  <% } %>
  <details style="margin-top:10px"><summary>Lihat kebijakan yang dipakai</summary><p><code><%= policy %></code></p></details>
</div>

<div class="panel">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
    <h2 style="margin:0"><%= rows.length %> jenis pelanggaran tercatat</h2>
    <% if (rows.length) { %><button class="btn" id="clr" type="button">Kosongkan catatan</button><% } %>
  </div>
  <% if (!rows.length) { %>
    <p class="note">Belum ada laporan. Ini kabar baik, atau dashboard belum banyak dibuka sejak fitur ini aktif.</p>
  <% } else { %>
  <div class="wrap" style="margin-top:10px">
    <table>
      <thead><tr><th>Jenis</th><th>Sumber yang akan terblokir</th><th>Halaman</th><th style="text-align:right">Jumlah</th><th>Terakhir</th></tr></thead>
      <tbody>
      <% rows.forEach(function (r) { %>
        <tr><td><code><%= r.directive %></code></td>
          <td><b><%= r.blocked %></b><% if (r.sample) { %><div class="muted" style="font-size:12px;word-break:break-all"><%= r.sample %></div><% } %></td>
          <td><%= r.page %></td><td class="n"><%= r.hits %></td>
          <td class="muted" style="white-space:nowrap"><%= new Date(r.last_seen).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short' }) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
(function () {
  var b = document.getElementById('clr');
  if (b) b.onclick = function () {
    if (!confirm('Kosongkan semua catatan laporan CSP?')) return;
    fetch('/api/admin/csp/clear', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' })
      .then(function (r) { return r.json(); }).then(function () { location.reload(); });
  };
})();
</script>
