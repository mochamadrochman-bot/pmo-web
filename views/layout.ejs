<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'PMO Dashboard' %></title>
  <script>try{var t=localStorage.getItem('pmoExecutiveTheme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch(e){}</script>
  <style>
    :root {
      --bg: #f2f5f9;
      --card: #ffffff;
      --tint: #f7fafe;
      --soft: #e7f1fa;
      --ink: #132b43;
      --navy: #073b63;
      --muted: #5b7085;
      --line: #d6e1ec;
      --pri: #1265aa;
      --pri-ink: #1265aa;
      --teal: #0f766e;
      --topbar: rgba(255, 255, 255, .96);
      --ok: #147a52;
      --ok-bg: #e6f6ef;
      --warn: #9a5b00;
      --warn-bg: #fff1d6;
      --err: #b42318;
      --err-bg: #fee4e2;
      --info: #0369a1;
      --info-bg: #e0f2fe;
      --purp: #6b35c4;
      --purp-bg: #efe8fc;
      --shadow: 0 2px 10px rgba(10, 28, 48, .05);
      color-scheme: light;
    }
    html[data-theme="dark"] {
      --bg: #0e1b28;
      --card: #172a3b;
      --tint: #132333;
      --soft: #1f384f;
      --ink: #e0edf7;
      --navy: #e6f2fc;
      --muted: #98b0c7;
      --line: #2b4156;
      --pri: #2878c4;
      --pri-ink: #89c6f8;
      --teal: #2dd4bf;
      --topbar: rgba(19, 35, 51, .96);
      --ok: #36c48c;
      --ok-bg: #12382c;
      --warn: #f5b942;
      --warn-bg: #3c2c10;
      --err: #f97066;
      --err-bg: #3f1b1d;
      --info: #7dd3fc;
      --info-bg: #0c2d48;
      --purp: #c4b5fd;
      --purp-bg: #2e1d52;
      --shadow: 0 8px 24px rgba(0, 0, 0, .28);
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font: 14px/1.5 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input, select { font: inherit; color: inherit; }
    a { color: var(--pri-ink); }
    code {
      background: var(--tint); border: 1px solid var(--line);
      padding: 1px 6px; border-radius: 5px; font-size: 12.5px; word-break: break-all;
    }

    /* Header / Topbar */
    header.topbar {
      position: sticky; top: 0; z-index: 40;
      background: var(--topbar); border-bottom: 1px solid var(--line);
      backdrop-filter: blur(8px);
    }
    .topbar-in {
      max-width: 1280px; margin: 0 auto; padding: 8px 20px;
      min-height: 58px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .brand-lk {
      display: inline-flex; align-items: center; gap: 9px; text-decoration: none;
      color: var(--navy); font-weight: 800; font-size: 15px; white-space: nowrap; flex: none;
    }
    .brand-badge {
      width: 30px; height: 30px; border-radius: 8px; background: var(--pri); color: #fff;
      display: grid; place-items: center; font-size: 11px; font-weight: 800; letter-spacing: .03em;
    }
    .topnav {
      display: flex; align-items: center; gap: 4px; flex: 1 1 auto; min-width: 0;
      overflow-x: auto; padding: 2px 0;
    }
    .topnav::-webkit-scrollbar { height: 0; }
    .topnav a {
      color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600;
      padding: 7px 11px; border-radius: 8px; white-space: nowrap; transition: background .15s, color .15s;
    }
    .topnav a:hover { background: var(--soft); color: var(--pri-ink); text-decoration: none; }
    .topnav a.active { background: var(--pri); color: #fff; }
    .top-right { display: flex; align-items: center; gap: 8px; flex: none; margin-left: auto; }
    .icon-btn {
      width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 8px;
      background: var(--card); color: var(--muted); display: grid; place-items: center; cursor: pointer; padding: 0;
    }
    .icon-btn:hover { background: var(--soft); color: var(--pri-ink); }
    .user-pill {
      display: inline-flex; align-items: center; gap: 7px; padding: 3px 10px 3px 4px;
      border: 1px solid var(--line); border-radius: 99px; background: var(--tint); font-size: 12px; color: var(--ink);
    }
    .user-av {
      width: 24px; height: 24px; border-radius: 50%; background: var(--pri); color: #fff;
      display: grid; place-items: center; font-size: 10.5px; font-weight: 700;
    }
    .btn-out {
      border: 1px solid var(--line); background: var(--card); color: var(--ink);
      border-radius: 8px; height: 34px; padding: 0 11px; font-size: 12.5px; font-weight: 600; cursor: pointer;
    }
    .btn-out:hover { background: var(--soft); }
    header form { margin: 0; }

    /* Layout & Typography */
    main { max-width: 1280px; margin: 0 auto; padding: 22px 20px 44px; }
    .pg-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
    .pg-kicker { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--pri-ink); margin-bottom: 3px; }
    h1 { font-size: 22px; font-weight: 800; color: var(--navy); margin: 0 0 4px; line-height: 1.25; }
    p.sub { color: var(--muted); margin: 0 0 18px; font-size: 13.5px; }
    .muted { color: var(--muted); }

    /* Cards & Panels */
    .panel {
      background: var(--card); border: 1px solid var(--line); border-radius: 12px;
      padding: 18px; margin: 0 0 16px; box-shadow: var(--shadow);
    }
    .panel h2 { font-size: 15.5px; font-weight: 700; margin: 0 0 6px; color: var(--navy); }
    .cols-2 { display: grid; grid-template-columns: 1.2fr .95fr; gap: 16px; align-items: start; }
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .kpi { background: var(--card); border: 1px solid var(--line); border-radius: 11px; padding: 13px 15px; box-shadow: var(--shadow); }
    .kpi small { display: block; font-size: 11.5px; color: var(--muted); font-weight: 600; }
    .kpi b { display: block; font-size: 20px; font-weight: 800; color: var(--navy); margin-top: 2px; font-variant-numeric: tabular-nums; }

    /* Toolbar & Inputs */
    .toolbar {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      padding: 12px 14px; background: var(--card); border: 1px solid var(--line);
      border-radius: 12px; margin-bottom: 14px; box-shadow: var(--shadow);
    }
    .search-box { position: relative; flex: 1 1 250px; min-width: 200px; }
    .search-box svg {
      position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
      width: 15px; height: 15px; color: var(--muted); pointer-events: none;
    }
    .search-box input { padding-left: 34px; }
    .tb-count { font-size: 12px; color: var(--muted); font-weight: 600; white-space: nowrap; margin-left: auto; }
    label { display: block; font-size: 12.5px; font-weight: 600; color: var(--muted); margin: 12px 0 5px; }
    input, select {
      width: 100%; height: 38px; padding: 0 11px; border: 1px solid var(--line);
      border-radius: 9px; font: inherit; font-size: 13.5px; background: var(--bg); color: var(--ink);
    }
    input[type="checkbox"], input[type="radio"] { height: auto; }
    input:focus, select:focus { outline: 2px solid var(--pri); outline-offset: -1px; border-color: var(--pri); }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      height: 38px; padding: 0 15px; border-radius: 9px; border: 1px solid var(--line);
      background: var(--card); color: var(--ink); font: inherit; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; white-space: nowrap;
    }
    .btn:hover:not(:disabled) { background: var(--soft); border-color: var(--pri); text-decoration: none; }
    .btn.utama, .btn.pri { background: var(--pri); border-color: var(--pri); color: #fff; }
    .btn.utama:hover:not(:disabled), .btn.pri:hover:not(:disabled) { filter: brightness(1.08); }
    .btn.kecil, .btn.sm { height: 30px; padding: 0 10px; font-size: 12px; border-radius: 7px; }
    .btn.danger { color: var(--err); border-color: rgba(180, 35, 24, .35); }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    button.primary {
      margin-top: 16px; width: 100%; height: 42px; padding: 0 14px; border: 0; border-radius: 9px;
      background: var(--pri); color: #fff; font: inherit; font-weight: 700; cursor: pointer;
    }
    button.primary:hover:not(:disabled) { filter: brightness(1.08); }

    /* Tables */
    .tbl-card, .tbl-wrap {
      background: var(--card); border: 1px solid var(--line); border-radius: 12px;
      overflow: hidden; box-shadow: var(--shadow);
    }
    .tbl-scroll, .tblwrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; background: var(--card); font-size: 13px; }
    th, td { text-align: left; padding: 10px 13px; border-bottom: 1px solid var(--line); vertical-align: middle; }
    th {
      background: var(--tint); font-size: 11.5px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .04em; color: var(--muted); white-space: nowrap;
    }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:hover td { background: var(--tint); }

    /* Badges & Status messages */
    .badge {
      display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px;
      border-radius: 6px; font-size: 11.5px; font-weight: 600; white-space: nowrap;
    }
    .b-ok, .b-input, .b-tim, .on, .enf { background: var(--ok-bg); color: var(--ok); }
    .b-warn, .b-kontraktor, .b-lock, .b-manual, .wait, .rep { background: var(--warn-bg); color: var(--warn); }
    .b-err, .b-off, .off { background: var(--err-bg); color: var(--err); }
    .b-info, .b-temp, .b-salin { background: var(--info-bg); color: var(--info); }
    .b-purp, .b-admin, .b-sena { background: var(--purp-bg); color: var(--purp); }
    .b-neu, .b-viewer, .b-reviewer { background: var(--tint); color: var(--muted); border: 1px solid var(--line); }

    .card {
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      padding: 24px; max-width: 440px; margin: 36px auto; box-shadow: var(--shadow);
    }
    .empty { padding: 24px; background: var(--card); color: var(--muted); text-align: center; }
    .err { color: var(--err); font-size: 13px; margin-top: 10px; }
    .ok { color: var(--ok); font-size: 13.5px; margin-top: 10px; }
    .msg { padding: 10px 13px; border-radius: 9px; font-size: 13.5px; margin-bottom: 14px; }
    .msg.ok { background: var(--ok-bg); color: var(--ok); margin-top: 0; }
    .msg.err { background: var(--err-bg); color: var(--err); margin-top: 0; }

    @media (max-width: 960px) {
      .cols-2 { grid-template-columns: 1fr; }
      .user-pill span:not(.user-av) { display: none; }
    }
    @media (max-width: 640px) {
      .topbar-in { padding: 8px 12px; gap: 8px; }
      main { padding: 16px 12px 32px; }
      .tb-count { margin-left: 0; width: 100%; }
    }
  </style>
</head>
<body>
  <% var curTitle = typeof title !== 'undefined' ? String(title) : ''; %>
  <% if (typeof user !== 'undefined' && user) { %>
    <% var roleLabel = { admin: 'Admin', input: 'Input / PIC', kontraktor: 'Kontraktor', viewer: 'Viewer', reviewer: 'Reviewer' }[user.role] || user.role; %>
    <% var avInit = String(user.full_name || user.username || 'PM').split(/\s+/).map(function(s){return s[0]||'';}).join('').slice(0,2).toUpperCase(); %>
    <header class="topbar">
      <div class="topbar-in">
        <a class="brand-lk" href="/">
          <span class="brand-badge">PMO</span>
          <span><%= user.role === 'admin' ? 'Admin Center' : 'PMO Dashboard' %></span>
        </a>
        <nav class="topnav" aria-label="Menu utama">
          <% if (!user.must_change_password) { %>
            <a href="/">← Portal</a>
            <% if (user.role === 'admin') { %>
              <a href="/admin/akun" class="<%= curTitle === 'Kelola Akun' ? 'active' : '' %>">Kelola Akun</a>
              <a href="/admin/data" class="<%= curTitle === 'Impor Data' ? 'active' : '' %>">Impor Data</a>
              <a href="/admin/kelompok" class="<%= curTitle === 'Kelompok Proyek' ? 'active' : '' %>">Kelompok Proyek</a>
              <a href="/admin/hero-portal" class="<%= curTitle === 'Hero Portal' ? 'active' : '' %>">Hero Portal</a>
              <a href="/admin/google" class="<%= curTitle === 'Koneksi Google' ? 'active' : '' %>">Koneksi Google</a>
              <a href="/admin/csp" class="<%= curTitle === 'Laporan CSP' ? 'active' : '' %>">Laporan CSP</a>
            <% } %>
            <% if (user.role === 'admin' || String(user.legacy_role || '').toUpperCase() === 'PIC') { %>
              <a href="/arsip" class="<%= curTitle.indexOf('Arsip') >= 0 ? 'active' : '' %>">Arsip Materi</a>
            <% } %>
            <a href="/akun/password" class="<%= curTitle === 'Ganti Password' ? 'active' : '' %>">Ganti Password</a>
          <% } %>
        </nav>
        <div class="top-right">
          <button type="button" class="icon-btn" id="adminThemeBtn" title="Ganti tema terang/gelap" aria-label="Ganti tema">☀</button>
          <span class="user-pill"><span class="user-av"><%= avInit %></span><span><%= user.full_name || user.username %> · <%= roleLabel %></span></span>
          <form method="post" action="/api/auth/logout">
            <button type="submit" class="btn-out">Keluar</button>
          </form>
        </div>
      </div>
    </header>
  <% } %>
  <main>
    <%- body %>
  </main>
  <script>
    (function () {
      var btn = document.getElementById('adminThemeBtn');
      if (!btn) return;
      function sync() {
        var dark = document.documentElement.dataset.theme === 'dark';
        btn.textContent = dark ? '☾' : '☀';
      }
      btn.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('pmoExecutiveTheme', next); } catch (e) {}
        sync();
      });
      sync();
    })();
  </script>
</body>
</html>
